  "main": "js/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./js/index.js"
    }
  },
  "files": [
    "js/index.js",
    "index.d.ts",
    "ios/",
    "android/",
    "hathor-ct-crypto-mobile.podspec",
    "LICENSE",
    "README.md",
    "SHA256SUMS"
  ],
  "scripts": {
    "test": "jest",
    "prepublishOnly": "node -e \"console.error('Refusing to publish from a directory: a release publishes the verified tarballs (see RELEASING.md).'); process.exit(1)\""
  },
  "dependencies": {
    "@hathor/ct-crypto-provider": "0.0.1-shielded",
    "buffer": "6.0.3"
  },
  "peerDependencies": {
