      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "jest": "30.4.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HathorNetwork/hathor-ct-crypto",
    "directory": "packages/ct-crypto-mobile"
  },
  "license": "MIT",
  "publishConfig": {
